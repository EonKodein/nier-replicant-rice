// With no layout set, niri uses the system keyboard layout (see `localectl`).
// For several layouts, add inside keyboard { }:
//     xkb { layout "us,ru"; options "grp:alt_shift_toggle"; }
input {
    keyboard {
        repeat-delay 250
        repeat-rate 45
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse
    workspace-auto-back-and-forth
}
